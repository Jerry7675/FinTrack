{
  "expo": {
    "name": "FinTrack",
    "slug": "fintech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fintrack",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F4F7F5",
      "translucent": true
    },
    "ios": {
      "bundleIdentifier": "com.fintrack.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.fintrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F533A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F533A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F533A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FinTrack to attach receipt and profile photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0F533A",
          "defaultChannel": "reminders"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "groupIdentifier": "group.com.fintrack.app",
          "widgets": [
            {
              "name": "FinTrackBalance",
              "displayName": "FinTrack Balance",
              "description": "Glance at your selected account balance",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.fintrack.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.fintrack.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f3766ccf-c364-44d1-86b4-b8605f2376a9"
      }
    },
    "owner": "sandeshxs-organization"
  }
}
