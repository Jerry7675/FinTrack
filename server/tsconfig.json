{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./api/**/*.ts", "./lib/**/*.ts", "./config.ts"],
  "exclude": ["node_modules", "**/__tests__/**"]
}
